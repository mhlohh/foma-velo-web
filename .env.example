# ============================================================
# Foma Velo environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# ---- Client (Vite, public) ---------------------------------
# Supabase project settings — Dashboard → Project Settings → API
# These are PUBLIC by design (protected by Supabase RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server (secret) ---------------------------------------
# Used by the /api/ai/analyze-training endpoint only.
GEMINI_API_KEY=
