# ============================================================
# Foma Velo environment template
# Copy to .env and fill in. NEVER commit the real .env file.
# ============================================================

# ---- Client (Vite, public) ---------------------------------
# Supabase project settings — Dashboard → Project Settings → API
# These are PUBLIC by design (protected by Supabase RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Server (secret) ---------------------------------------
# Used by the /api/ai/analyze-training endpoint only.
GEMINI_API_KEY=

# ---- Strava Daily Scraper Microservice ---------------------
# Service role key from Supabase Dashboard → Project Settings → API (secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
# 32+ character secret used to AES-256-GCM encrypt Strava passwords at rest
STRAVA_ENCRYPTION_KEY=replace-with-a-random-32-byte-secret
# Cron schedule for daily Strava scrape inside the Docker container (default: 02:00 AM daily)
SYNC_CRON_SCHEDULE="0 2 * * *"
# URL of the scraper microservice (http://127.0.0.1:4001 locally, http://strava-scraper:4001 in Docker)
STRAVA_SCRAPER_URL=http://127.0.0.1:4001
