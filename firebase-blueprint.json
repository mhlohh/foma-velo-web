{
  "entities": {
    "UserSettings": {
      "title": "UserSettings",
      "description": "User preferences and thresholds for cycling/running calculations",
      "type": "object",
      "properties": {
        "ftp": { "type": "number" },
        "lthr": { "type": "number" },
        "maxHr": { "type": "number" },
        "weightKg": { "type": "number" },
        "calculationMode": { "type": "string" },
        "ctlDays": { "type": "number" },
        "atlDays": { "type": "number" }
      },
      "required": ["ftp", "lthr", "maxHr", "weightKg", "calculationMode", "ctlDays", "atlDays"]
    },
    "ActivityEntity": {
      "title": "ActivityEntity",
      "description": "A single workout/ride activity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "stravaActivityId": { "type": "string" },
        "dateMillis": { "type": "number" },
        "name": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "maxLength": 100 },
        "movingTimeSec": { "type": "number" },
        "elapsedTimeSec": { "type": "number" },
        "distanceMeters": { "type": "number" },
        "elevationGainMeters": { "type": "number" },
        "avgWatts": { "type": "number" },
        "maxWatts": { "type": "number" },
        "weightedWatts": { "type": "number" },
        "avgHr": { "type": "number" },
        "maxHr": { "type": "number" },
        "kilojoules": { "type": "number" },
        "stravaTss": { "type": "number" },
        "isPlanned": { "type": "boolean" },
        "notes": { "type": "string", "maxLength": 2000 },
        "userId": { "type": "string" }
      },
      "required": ["id", "dateMillis", "name", "type", "movingTimeSec", "elapsedTimeSec", "distanceMeters", "elevationGainMeters", "isPlanned"]
    }
  },
  "firestore": {
    "/users/{userId}/activities/{activityId}": {
      "schema": "ActivityEntity",
      "description": "Stores individual cycling and multi-sport activities for a user"
    },
    "/users/{userId}/settings/user_settings": {
      "schema": "UserSettings",
      "description": "Stores user parameters like FTP, LTHR, and time constants"
    }
  }
}
